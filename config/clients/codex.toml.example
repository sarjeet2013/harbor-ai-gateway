# Codex — put in user-level ~/.codex/config.toml (NOT project .codex/)
# Local loopback works when Codex runs on the same machine as the gateway.

openai_base_url = "http://127.0.0.1:4000/v1"

# Preferred: named provider with Responses wire API (Codex default path)
# model = "ollama-cheap"  # or mock-cheap when using gateway.mock.yaml
# model_provider = "local_gateway"
#
# [model_providers.local_gateway]
# name = "Harbor AI Gateway"
# base_url = "http://127.0.0.1:4000/v1"
# env_key = "LOCAL_GATEWAY_API_KEY"
# wire_api = "responses"
#
# Edge implements POST /v1/responses (plus /v1/chat/completions).
# In litellm/Ollama mode the edge translates responses → chat/completions.
