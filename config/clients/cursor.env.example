# Cursor — requests originate from Cursor cloud, NOT your laptop.
# Docs: docs/features/cursor.md
#
# 1. python -m edge start   (edge :4000)
# 2. HTTPS tunnel to the edge, e.g.:
#      ~/bin/cloudflared tunnel --url http://127.0.0.1:4000 --protocol http2 --no-autoupdate
# 3. Cursor Settings → Models → OpenAI
#      Override OpenAI Base URL = https://<tunnel-host>/cursor
#      OpenAI API Key           = sk-local-gateway  (any non-empty; keep provider keys in Harbor .env)
#      Custom models            = ollama-cheap , openai-expensive
#
# Harbor serves /cursor/chat/completions and /cursor/models itself (budget/router/cache/ledger),
# not a blind LiteLLM /cursor proxy.

CURSOR_GATEWAY_BASE_URL=https://YOUR_TUNNEL_HOST/cursor
CURSOR_GATEWAY_API_KEY=sk-local-gateway
