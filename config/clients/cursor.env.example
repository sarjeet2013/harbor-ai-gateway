# Cursor — requests originate from Cursor cloud, NOT your laptop.
# 1. Run the gateway locally (:4000)
# 2. Expose HTTPS (example: cloudflared / ngrok) to the edge
# 3. Cursor Settings → Models → Override OpenAI Base URL
#
# Preferred (LiteLLM Cursor path):
#   https://<your-tunnel-host>/cursor
# Fallback if Override Base URL missing: Azure OpenAI panel with
#   https://<your-tunnel-host>   (no /cursor) + deployment = LiteLLM model name
#
# API key = gateway / LiteLLM virtual key (not your raw provider key in Cursor if you can avoid it)

CURSOR_GATEWAY_BASE_URL=https://YOUR_TUNNEL_HOST/cursor
CURSOR_GATEWAY_API_KEY=sk-local-gateway
