# Claude Code — Anthropic Messages API, not OpenAI chat alone.
# Docs: https://code.claude.com/docs/en/llm-gateway-connect

export ANTHROPIC_BASE_URL=http://127.0.0.1:4000
export ANTHROPIC_AUTH_TOKEN=sk-local-gateway
# or: ANTHROPIC_API_KEY=sk-local-gateway

# Persist in ~/.claude/settings.json:
# {
#   "env": {
#     "ANTHROPIC_BASE_URL": "http://127.0.0.1:4000",
#     "ANTHROPIC_AUTH_TOKEN": "sk-local-gateway"
#   }
# }
#
# Edge exposes Anthropic-compatible /v1/messages. In litellm/Ollama mode the edge
# translates to /v1/chat/completions (see edge/translate.py).
# Harbor supports Anthropic Messages SSE on /v1/messages (stream:true) for Claude Code.

# Optional: pin a Harbor cheap alias (disables auto task-class for that request):
# export ANTHROPIC_MODEL=ollama-cheap   # force 8b chat
# export ANTHROPIC_MODEL=ollama-coder   # force coder 14b
# Leave unset / use a non-Harbor model id to let Harbor heuristics + task-class route
# (default land: ollama-cheap; coder/reason keywords → ollama-coder / ollama-reason).
# See docs/features/routing.md
