# Claude Code — Anthropic Messages API, not OpenAI chat alone.
# Docs: https://code.claude.com/docs/en/llm-gateway-connect

export ANTHROPIC_BASE_URL=http://127.0.0.1:4000
export ANTHROPIC_AUTH_TOKEN=sk-local-gateway
# or: ANTHROPIC_API_KEY=sk-local-gateway

# Persist in ~/.claude/settings.json:
# {
#   "env": {
#     "ANTHROPIC_BASE_URL": "http://127.0.0.1:4000",
#     "ANTHROPIC_AUTH_TOKEN": "sk-local-gateway"
#   }
# }
#
# Edge must expose Anthropic-compatible /v1/messages (via LiteLLM or thin adapter).
