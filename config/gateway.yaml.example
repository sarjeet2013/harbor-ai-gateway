# Edge + LiteLLM pointer (v0)
listen: "0.0.0.0:4000"
litellm_base_url: "http://127.0.0.1:4001"
upstream_mode: mock  # mock | litellm

daily_budget_usd: 10.0
on_budget_exceeded: force_cheap  # force_cheap | reject
budget_state_path: "data/budget.json"

why_log_path: "logs/why.jsonl"

cost_estimates_usd:
  cheap_per_request: 0.001
  expensive_per_request: 0.02

models:
  cheap: ["mock-cheap", "gpt-4o-mini", "ollama/llama3.2"]
  expensive: ["mock-expensive", "claude-sonnet-4", "gpt-4o"]

router:
  strategy: heuristic_cost_first
  expensive_keywords:
    - "refactor"
    - "architecture"
    - "design a system"
    - "complex"
    - "analyze the entire"
    - "write a detailed"
  expensive_min_chars: 2000
