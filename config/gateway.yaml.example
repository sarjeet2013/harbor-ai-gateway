# Edge + LiteLLM pointer (v0)
listen: "0.0.0.0:4000"
litellm_base_url: "http://127.0.0.1:4001"
upstream_mode: litellm  # mock | litellm  (use litellm for Ollama e2e)

daily_budget_usd: 10.0
on_budget_exceeded: force_cheap  # force_cheap | reject
budget_state_path: "data/budget.json"

why_log_path: "logs/why.jsonl"

cost_estimates_usd:
  cheap_per_request: 0.0
  expensive_per_request: 0.0

models:
  # Ollama e2e (see RUN_OLLAMA.md). For mock demos use ["mock-cheap"] / ["mock-expensive"].
  cheap: ["ollama-cheap"]
  expensive: ["ollama-expensive"]

router:
  strategy: heuristic_cost_first
  expensive_keywords:
    - "refactor"
    - "architecture"
    - "design a system"
    - "complex"
    - "analyze the entire"
    - "write a detailed"
  expensive_min_chars: 2000
