# Canonical config template — copy to gateway.yaml and edit.
# Do NOT hand-edit litellm_config.yaml (deprecated).
# CLI writes config/.generated_litellm.yaml from `models:` (override with GATEWAY_LITELLM_CONFIG).
listen: "0.0.0.0:4000"
litellm_host: "127.0.0.1"
litellm_port: 4001
upstream_mode: litellm  # mock | litellm

daily_budget_usd: 10.0
on_budget_exceeded: force_cheap  # force_cheap | reject
budget_state_path: "data/budget.json"
why_log_path: "logs/why.jsonl"

cost_estimates_usd:
  cheap_per_request: 0.0
  expensive_per_request: 0.0

models:
  # Unified shape (preferred). Alias `name` is what the router sends to LiteLLM.
  cheap:
    - name: ollama-cheap
      litellm_model: ollama/llama3.2:1b
      api_base: http://127.0.0.1:11434
  expensive:
    - name: ollama-expensive
      litellm_model: ollama/llama3.2:3b
      api_base: http://127.0.0.1:11434
  # Legacy still works: cheap: ["mock-cheap"] with a separate litellm config,
  # or mock mode with name-only entries (no litellm_model).

router:
  strategy: heuristic_cost_first
  expensive_keywords:
    - "refactor"
    - "architecture"
    - "design a system"
    - "complex"
    - "analyze the entire"
    - "write a detailed"
  expensive_min_chars: 2000

# Exact response cache (semantic mode planned — see docs/features/cache.md)
cache:
  enabled: true
  mode: exact   # exact | semantic (semantic planned)
  ttl_seconds: 86400
  max_entries: 1000
  path: data/cache
  # semantic later: embedding_model, similarity_threshold
